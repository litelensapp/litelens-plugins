{
  "name": "@litelens/helm-plugin-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm build:css && tsup",
    "build:css": "tailwindcss -i src/style.css -o src/generated-style.css --minify",
    "build:report": "pnpm build:css && cross-env ANALYZE=true tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@litelens/design-system": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "esbuild-visualizer": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
