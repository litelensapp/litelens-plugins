{
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "helm/frontend/**",
      "options": {
        "tailwindStylesheet": "helm/frontend/src/style.css"
      }
    }
  ]
}
